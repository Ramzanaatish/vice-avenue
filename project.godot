; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
; VICE AVENUE — Ready to Build v4.0, Step 5 (Slice B: vehicle, Mission 04, inventory, save/load).
; Godot 4.7.x (pin one exact patch, e.g. 4.7.2).
; Title DECIDED 21 Nov 2026 (Gate 0.1): "Vice Avenue", package
; com.devflowia.viceavenue. Android Debug export preset added
; (export_presets.cfg); the APK itself is built on Nelson's PC
; (export templates + Android SDK) — Gate 1.
; greybox), S18 Player + camera, S07 HUD + touch controls and
; S06 Pause Menu. Autoload order matters:
; AudioManager runs BEFORE SettingsManager, because
; SettingsManager.apply_settings() touches the audio buses
; that AudioManager creates.

config_version=5

[application]

config/name="Vice Avenue"
config/description="Original offline single-player 3D open-world crime/adventure game for Android. Title: Vice Avenue (com.devflowia.viceavenue)."
config/icon="res://icon.png"
run/main_scene="res://scenes/core/app_root.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.05, 0.08, 1)

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
VersionManager="*res://scripts/autoload/version_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
MissionManager="*res://scripts/autoload/mission_manager.gd"
EconomyManager="*res://scripts/autoload/economy_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
SecurityManager="*res://scripts/autoload/security_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

